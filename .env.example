CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8000
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.8-flash
# Prefer DASHSCOPE_API_KEY; do not commit a real key here.
MODEL_API_KEY=
# Vision extraction model (LLaMA-Factory InternVL OpenAI-compatible API)
VISION_MODEL_BASE_URL=http://127.0.0.1:5003/v1
VISION_MODEL_NAME=vl
# Usually empty for the local service; set when authentication is enabled.
VISION_MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=120
MODEL_ENABLE_THINKING=true
AGENT_MODE=auto
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/chatbot
UPLOAD_DIR=/workspace/team3/chatbot/data/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOW_ORIGINS=http://localhost:8000,http://localhost:5173
