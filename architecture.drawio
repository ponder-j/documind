<mxfile host="app.diagrams.net" modified="2026-09-01T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="documind-architecture" name="企业文档处理智能体系统架构">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="企业文档处理对话智能体系统（DocuMind）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937" vertex="1" parent="1"><mxGeometry x="40" y="25" width="720" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="代码依据：agent/api.py · frontend/index.html · scripts/init_db.py · scripts/deploy_remote.sh" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280" vertex="1" parent="1"><mxGeometry x="42" y="62" width="900" height="25" as="geometry"/></mxCell>

        <mxCell id="client" value="用户 / 浏览器\n上传 PNG 发注书\n输入中文问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1ff;strokeColor=#4f81bd;fontSize=16;fontStyle=1" vertex="1" parent="1"><mxGeometry x="55" y="180" width="190" height="110" as="geometry"/></mxCell>
        <mxCell id="frontend" value="前端单页应用\nfrontend/index.html\n• 对话历史（localStorage）\n• Markdown 渲染\n• FormData 上传\n• POST /api/chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7e8;strokeColor=#70ad47;fontSize=14" vertex="1" parent="1"><mxGeometry x="300" y="155" width="245" height="160" as="geometry"/></mxCell>

        <mxCell id="api" value="FastAPI 服务\nagent/api.py\nGET /health · GET /\nPOST /api/chat\nPOST /api/documents/import\n会话：sessions / session_context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="610" y="145" width="280" height="180" as="geometry"/></mxCell>

        <mxCell id="upload" value="图片处理分支\n校验：单张、PNG、≤10 MB\n保存 upload_dir\nmodel_extract / mock_extract\n待确认 pending_extraction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#c55a11;fontSize=14" vertex="1" parent="1"><mxGeometry x="965" y="105" width="275" height="155" as="geometry"/></mxCell>
        <mxCell id="chatroute" value="对话路由\nmodel_agent（Qwen 工具调用）\n失败时 deterministic_agent 回退\nclassify / extract_filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4d6;strokeColor=#c55a11;fontSize=14" vertex="1" parent="1"><mxGeometry x="965" y="300" width="275" height="155" as="geometry"/></mxCell>

        <mxCell id="model" value="多模态 / 对话模型\nDashScope OpenAI 兼容 API\n默认：qwen3.8-flash\nMODEL_BASE_URL + API Key\n• 视觉 JSON 抽取\n• 意图理解与工具选择\n• 中文答案生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1310" y="115" width="245" height="200" as="geometry"/></mxCell>

        <mxCell id="tools" value="白名单业务工具（Python 执行）\nquery_orders\naggregate_sales\ntrend_analysis\ncompany_ranking\npython_statistics\ndatabase_status\nimport_pending_document" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14" vertex="1" parent="1"><mxGeometry x="965" y="520" width="275" height="205" as="geometry"/></mxCell>
        <mxCell id="db" value="PostgreSQL\nchatbot.orders\n订单字段：image_name、customer_company、\norder_date、source_company、project、\nquantity、unit_price、total_amount\n索引：customer_company + order_date" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1310" y="525" width="245" height="190" as="geometry"/></mxCell>

        <mxCell id="init" value="数据初始化\nscripts/init_db.py\n读取 output_label.xlsx / CSV\n清洗日期与数值\n批量导入 orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14" vertex="1" parent="1"><mxGeometry x="610" y="555" width="280" height="145" as="geometry"/></mxCell>
        <mxCell id="data" value="标注数据资产\nmaterials/班级7用数据/\ntrain / val / sales PNG\noutput_label.xlsx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14" vertex="1" parent="1"><mxGeometry x="300" y="555" width="245" height="145" as="geometry"/></mxCell>

        <mxCell id="deploy" value="远程部署（server-4090）\nscripts/deploy_remote.sh\nSSH + rsync → /workspace/forth/chatbot\nteam3 Conda / .venv\nPostgreSQL + FastAPI（默认 8000）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14" vertex="1" parent="1"><mxGeometry x="55" y="555" width="190" height="145" as="geometry"/></mxCell>

        <mxCell id="note" value="安全与可靠性边界\n• 模型只能选择 TOOL_SCHEMAS 白名单工具\n• SQL 在 Python 端拼接参数化条件，不接受用户原始 SQL\n• 导入按会话/图片 key 幂等，需用户明确确认\n• Qwen 不可用时使用同一组本地工具回退" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#999999;dashed=1;fontSize=13;fontColor=#374151" vertex="1" parent="1"><mxGeometry x="610" y="760" width="640" height="115" as="geometry"/></mxCell>

        <mxCell id="e1" value="HTTP / FormData" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;fontSize=12" edge="1" parent="1" source="client" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="POST /api/chat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;fontSize=12" edge="1" parent="1" source="frontend" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="files 存在" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12" edge="1" parent="1" source="api" target="upload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="纯文本问题" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12" edge="1" parent="1" source="api" target="chatroute"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="视觉识别 / 对话请求" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;fontSize=12" edge="1" parent="1" source="upload" target="model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="工具选择 + 结果总结" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;fontSize=12" edge="1" parent="1" source="chatroute" target="model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="tool_calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;fontSize=12" edge="1" parent="1" source="model" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="查询 / 聚合 / 导入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;fontSize=12" edge="1" parent="1" source="tools" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="tool result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;fontSize=12" edge="1" parent="1" source="tools" target="model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="JSON / answer / summary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;strokeWidth=2;fontSize=12" edge="1" parent="1" source="api" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="标注导入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12" edge="1" parent="1" source="data" target="init"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;fontSize=12" edge="1" parent="1" source="init" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="部署与运行" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;dashed=1;fontSize=12" edge="1" parent="1" source="deploy" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
